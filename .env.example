# Public configuration for the UnderRock shell.
#
# Copy to .env.local for development. In CI these come from repository *variables*
# (Settings -> Secrets and variables -> Actions -> Variables), not secrets, because both
# values are public by design.
#
# NOTHING SECRET BELONGS IN THIS FILE OR IN .env.local:
#   - not the Supabase service-role / secret key
#   - not the Google OAuth client secret
#   - not the shared access password, or anything derived from it
#
# The build refuses to start if VITE_SUPABASE_ANON_KEY looks like a service-role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Only change this if you fork the project under a different repository name.
VITE_BASE_PATH=/LaTeXRenderer/
