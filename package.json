{
  "name": "underrock-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public GitHub Pages shell for UnderRock: Google sign-in, shared-password gate, and hash-verified delivery of the protected editor application.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:direct": "playwright test --config=playwright.direct.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "sync:app": "node scripts/sync-app.mjs",
    "lock:app": "node scripts/encrypt-app.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs . --include-dist",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run scan:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.1",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
